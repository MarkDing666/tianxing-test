{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tianxing-test",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash"
  },
  "durable_objects": {
    "bindings": [{ "name": "CODES", "class_name": "CodeStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CodeStore"] }]
}
